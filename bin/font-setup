#!/usr/bin/env bash
###***font-setup***###
# Font setup and management for brewsearch

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

echo
echo "╔════════════════════════════════════════╗"
echo "║  BrewSearch Font Setup                 ║"
echo "╚════════════════════════════════════════╝"
echo

# Check current font
CURRENT_FONT=$(osascript -e 'tell application "Terminal" to get name of font of window 1' 2>/dev/null || echo "Unknown")

echo -e "${BLUE}Current Terminal Font:${NC} $CURRENT_FONT"
echo

# Check if FiraCode Nerd Font is installed
if fc-list 2>/dev/null | grep -qi "FiraCode.*Nerd" || ls ~/Library/Fonts/*FiraCode*Nerd* 2>/dev/null | grep -q .; then
    echo -e "${GREEN}✓${NC} FiraCode Nerd Font Mono is installed"
    if [[ "$CURRENT_FONT" == *"FiraCode"* ]]; then
        echo -e "${GREEN}✓${NC} You're already using FiraCode Nerd Font!"
        echo
        exit 0
    fi
else
    echo -e "${YELLOW}⚠${NC} FiraCode Nerd Font Mono is not installed"
fi

echo
echo -e "${CYAN}Why use a Nerd Font?${NC}"
echo "  • Better icon and symbol support"
echo "  • Enhanced visual appearance"
echo "  • Consistent monospaced layout"
echo "  • Recommended for BrewSearch"
echo

echo "Choose an option:"
echo
echo "  1) Auto-install FiraCode Nerd Font Mono (Recommended)"
echo "  2) Browse fonts at programmingfonts.org and install"
echo "  3) Install via Homebrew (manual)"
echo "  4) Download and install manually"
echo "  5) Patch your existing font (Advanced)"
echo "  6) Continue with current font"
echo

read -p "Enter your choice (1-6): " choice

case $choice in
    1)
        echo
        echo -e "${BLUE}Installing FiraCode Nerd Font Mono...${NC}"
        
        # Download and install using Homebrew Cask
        if command -v brew >/dev/null 2>&1; then
            echo "Using Homebrew to install..."
            brew install --cask font-fira-code-nerd-font
            
            if [ $? -eq 0 ]; then
                echo -e "${GREEN}✓${NC} FiraCode Nerd Font Mono installed successfully!"
                echo
                echo "To use the font:"
                echo "  1. Open Terminal Preferences (⌘,)"
                echo "  2. Go to Profiles → Text"
                echo "  3. Click 'Change' under Font"
                echo "  4. Select 'FiraCode Nerd Font Mono'"
                echo
            else
                echo -e "${RED}✗${NC} Installation failed"
            fi
        else
            echo -e "${RED}✗${NC} Homebrew not found. Please install Homebrew first."
        fi
        ;;
        
    2)
        echo
        echo -e "${BLUE}Opening programmingfonts.org...${NC}"
        open "https://www.programmingfonts.org/"
        echo
        echo "After selecting a font:"
        echo "  1. Note the font name"
        echo "  2. Visit https://www.nerdfonts.com/font-downloads"
        echo "  3. Download the Nerd Font version"
        echo "  4. Install by double-clicking the .ttf/.otf files"
        echo
        ;;
        
    3)
        echo
        echo -e "${BLUE}Homebrew Installation Commands:${NC}"
        echo
        echo "FiraCode Nerd Font:"
        echo -e "  ${CYAN}brew install --cask font-fira-code-nerd-font${NC}"
        echo
        echo "Other popular Nerd Fonts:"
        echo -e "  ${CYAN}brew install --cask font-hack-nerd-font${NC}"
        echo -e "  ${CYAN}brew install --cask font-jetbrains-mono-nerd-font${NC}"
        echo -e "  ${CYAN}brew install --cask font-meslo-lg-nerd-font${NC}"
        echo -e "  ${CYAN}brew install --cask font-source-code-pro${NC}"
        echo
        echo "Search for more:"
        echo -e "  ${CYAN}brew search nerd-font${NC}"
        echo
        ;;
        
    4)
        echo
        echo -e "${BLUE}Manual Installation:${NC}"
        echo
        echo "1. Visit: ${CYAN}https://www.nerdfonts.com/font-downloads${NC}"
        echo "2. Download 'FiraCode Nerd Font'"
        echo "3. Unzip the downloaded file"
        echo "4. Double-click the .ttf files to install"
        echo "5. Restart Terminal"
        echo "6. Set font in Terminal Preferences"
        echo
        open "https://www.nerdfonts.com/font-downloads"
        ;;
        
    5)
        echo
        echo -e "${YELLOW}Advanced: Font Patcher${NC}"
        echo
        echo "This will patch your existing font with Nerd Font icons."
        echo
        echo "Steps:"
        echo "1. Download Font Patcher:"
        echo -e "   ${CYAN}https://github.com/ryanoasis/nerd-fonts/releases/latest/download/FontPatcher.zip${NC}"
        echo
        echo "2. Install dependencies:"
        echo -e "   ${CYAN}brew install fontforge${NC}"
        echo
        echo "3. Run patcher:"
        echo -e "   ${CYAN}fontforge -script FontPatcher /path/to/your/font.ttf${NC}"
        echo
        echo "4. Documentation:"
        echo -e "   ${CYAN}https://github.com/ryanoasis/nerd-fonts/wiki/ScriptOptions${NC}"
        echo
        read -p "Open Font Patcher download page? (y/N) " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            open "https://github.com/ryanoasis/nerd-fonts/releases/latest"
        fi
        ;;
        
    6)
        echo
        echo -e "${YELLOW}⚠${NC} Continuing with current font: $CURRENT_FONT"
        echo
        echo "Note: Some icons and symbols may not display correctly"
        echo "without a Nerd Font. You can run this script again anytime:"
        echo -e "  ${CYAN}./bin/font-setup${NC}"
        echo
        ;;
        
    *)
        echo
        echo -e "${RED}Invalid choice${NC}"
        exit 1
        ;;
esac
